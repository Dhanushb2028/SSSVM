// SSSVM School Management System — Prisma schema
// Phase 1: core organizational hierarchy, people, auth, and RBAC.
// Later phases add academics/finance/comms/etc. tables via new migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organizational hierarchy
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches         Branch[]
  courses          Course[]
  subjects         Subject[]
  examTypes        ExamType[]
  competitiveExams CompetitiveExam[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  city           String?
  address        String?
  phone          String?
  isHostel       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  academicYears  AcademicYear[]
  sections       Section[]
  students       Student[]
  staffMembers   StaffMember[]
  users          User[]
  appBanners     AppBanner[]
  scheduleEvents ScheduleEvent[]
  exams          Exam[]
  notifications  Notification[]
  circulars      Circular[]
  galleryAlbums  GalleryAlbum[]
  videos         Video[]

  @@index([organizationId])
  @@map("branches")
}

model AcademicYear {
  id        String   @id @default(cuid())
  branchId  String
  name      String // e.g. "2025-2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   Branch    @relation(fields: [branchId], references: [id])
  sections Section[]
  exams    Exam[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("academic_years")
}

model Course {
  id             String    @id @default(cuid())
  organizationId String
  name           String // e.g. "Grade 5"
  orderIndex     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  sections     Section[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("courses")
}

model Subject {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization     Organization        @relation(fields: [organizationId], references: [id])
  timetableEntries TimetableEntry[]
  syllabusTopics   SyllabusTopic[]
  lessonPlans      MonthlyLessonPlan[]
  examSubjects     ExamSubject[]
  homework         Homework[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("subjects")
}

// A Section is a year-specific mapping of a Course to a Branch, e.g. "5-A" for 2025-2026.
model Section {
  id             String    @id @default(cuid())
  academicYearId String
  branchId       String
  courseId       String
  name           String // e.g. "A"
  capacity       Int?
  classTeacherId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  academicYear     AcademicYear        @relation(fields: [academicYearId], references: [id])
  branch           Branch              @relation(fields: [branchId], references: [id])
  course           Course              @relation(fields: [courseId], references: [id])
  classTeacher     StaffMember?        @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])
  students         Student[]
  attendance       Attendance[]
  timetableEntries TimetableEntry[]
  syllabusTopics   SyllabusTopic[]
  lessonPlans      MonthlyLessonPlan[]
  homework         Homework[]
  notifications    Notification[]
  circulars        Circular[]

  @@unique([academicYearId, branchId, courseId, name])
  @@index([academicYearId])
  @@index([branchId])
  @@index([courseId])
  @@map("sections")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum StudentStatus {
  ACTIVE
  PROMOTED
  LEFT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Student {
  id              String        @id @default(cuid())
  admissionNumber String        @unique
  branchId        String
  sectionId       String?
  firstName       String
  lastName        String
  dob             DateTime
  gender          Gender
  photoUrl        String?
  bloodGroup      String?
  address         String?
  contactPhone    String?
  contactEmail    String?
  admissionDate   DateTime      @default(now())
  status          StudentStatus @default(ACTIVE)
  leftDate        DateTime?
  leftReason      String?
  tcEligible      Boolean       @default(false)
  tcIssued        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  branch               Branch                @relation(fields: [branchId], references: [id])
  section              Section?              @relation(fields: [sectionId], references: [id])
  guardians            StudentGuardian[]
  user                 User?
  attendance           Attendance[]
  examMarks            ExamMark[]
  competitiveExamMarks CompetitiveExamMark[]
  homeworkSubmissions  HomeworkSubmission[]
  notifications        Notification[]
  chatThread           ChatThread?

  @@index([branchId])
  @@index([sectionId])
  @@index([status])
  @@index([deletedAt])
  @@map("students")
}

model Guardian {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  phone     String    @unique
  email     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  students StudentGuardian[]
  user     User?

  @@index([deletedAt])
  @@map("guardians")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model StudentGuardian {
  id           String               @id @default(cuid())
  studentId    String
  guardianId   String
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  createdAt    DateTime             @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
  @@map("student_guardians")
}

model StaffMember {
  id           String    @id @default(cuid())
  branchId     String
  employeeCode String    @unique
  firstName    String
  lastName     String
  designation  String
  phone        String
  email        String?
  address      String?
  joinDate     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  branch           Branch           @relation(fields: [branchId], references: [id])
  user             User?
  classesAsTeacher Section[]        @relation("SectionClassTeacher")
  timetableEntries TimetableEntry[]

  @@index([branchId])
  @@index([deletedAt])
  @@map("staff_members")
}

// ---------------------------------------------------------------------------
// Auth & RBAC
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  EXPORT
}

// Named permission sets assignable to ADMIN-role users to scope them to a subset
// of admin modules (e.g. "Front Office", "Finance Staff") without a new top-level role.
model PermissionProfile {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants PermissionGrant[]
  users  User[]

  @@map("permission_profiles")
}

// One row per (profile, module, action) grant, e.g. ("Finance Staff", "finance.fees", VIEW).
model PermissionGrant {
  id                  String           @id @default(cuid())
  permissionProfileId String
  module              String
  action              PermissionAction

  permissionProfile PermissionProfile @relation(fields: [permissionProfileId], references: [id])

  @@unique([permissionProfileId, module, action])
  @@index([permissionProfileId])
  @@map("permission_grants")
}

model User {
  id                  String    @id @default(cuid())
  role                Role
  username            String?   @unique // ADMIN / TEACHER login identifier
  mobile              String?   @unique // STUDENT / PARENT login identifier
  // Standalone admin accounts (no linked StaffMember/Student/Guardian) store their
  // own name/email here; linked accounts source these from the linked person record.
  name                String?
  email               String?   @unique
  passwordHash        String
  isActive            Boolean   @default(true)
  // Restricts an ADMIN-role user to one branch; null means org-wide (all branches) access.
  branchId            String?
  permissionProfileId String?
  studentId           String?   @unique
  guardianId          String?   @unique
  staffMemberId       String?   @unique
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  branch            Branch?            @relation(fields: [branchId], references: [id])
  permissionProfile PermissionProfile? @relation(fields: [permissionProfileId], references: [id])
  student           Student?           @relation(fields: [studentId], references: [id])
  guardian          Guardian?          @relation(fields: [guardianId], references: [id])
  staffMember       StaffMember?       @relation(fields: [staffMemberId], references: [id])

  sessions         Session[]
  auditLogs        AuditLog[]
  attendanceMarked Attendance[]
  chatMessages     ChatMessage[]

  @@index([role])
  @@index([branchId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Required for all destructive/financial actions per Section 9: fee cancellations,
// bank transaction cancellations, bulk promotions, certificate-eligibility changes, bulk SMS.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "fee_receipt.cancel", "student.bulk_promote"
  entityType String // e.g. "FeeTransaction"
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2: Student home-screen banners (Section 6.4 "App home banners")
// ---------------------------------------------------------------------------

model AppBanner {
  id         String   @id @default(cuid())
  branchId   String
  title      String?
  imageUrl   String
  linkUrl    String?
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("app_banners")
}

// ---------------------------------------------------------------------------
// Phase 3: Attendance & Timetable (Section 6.6, 6.7 timetable)
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model Attendance {
  id             String           @id @default(cuid())
  studentId      String
  sectionId      String
  date           DateTime         @db.Date
  status         AttendanceStatus
  markedByUserId String?
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student  Student @relation(fields: [studentId], references: [id])
  section  Section @relation(fields: [sectionId], references: [id])
  markedBy User?   @relation(fields: [markedByUserId], references: [id])

  @@unique([studentId, date])
  @@index([sectionId, date])
  @@map("attendance")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model TimetableEntry {
  id        String   @id @default(cuid())
  sectionId String
  weekday   Weekday
  period    Int
  subjectId String
  teacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section Section      @relation(fields: [sectionId], references: [id])
  subject Subject      @relation(fields: [subjectId], references: [id])
  teacher StaffMember? @relation(fields: [teacherId], references: [id])

  @@unique([sectionId, weekday, period])
  @@index([sectionId])
  @@map("timetable_entries")
}

// ---------------------------------------------------------------------------
// Phase 4: Syllabus, Schedule, Lesson Plans (Section 6.7)
// ---------------------------------------------------------------------------

model SyllabusTopic {
  id            String    @id @default(cuid())
  sectionId     String
  subjectId     String
  topic         String
  description   String?
  plannedDate   DateTime  @db.Date
  completedDate DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([sectionId])
  @@index([subjectId])
  @@map("syllabus_topics")
}

model ScheduleEvent {
  id          String    @id @default(cuid())
  branchId    String
  title       String
  description String?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("schedule_events")
}

model MonthlyLessonPlan {
  id        String   @id @default(cuid())
  sectionId String
  subjectId String
  month     Int // 1-12
  year      Int
  planText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([sectionId, subjectId, month, year])
  @@index([sectionId])
  @@map("monthly_lesson_plans")
}

// ---------------------------------------------------------------------------
// Phase 4: Exams & Assessments (Section 6.8)
// ---------------------------------------------------------------------------

model ExamType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  exams        Exam[]

  @@unique([organizationId, name])
  @@map("exam_types")
}

model Exam {
  id             String    @id @default(cuid())
  branchId       String
  academicYearId String
  examTypeId     String
  name           String
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  includeInRank  Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  branch       Branch        @relation(fields: [branchId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  examType     ExamType      @relation(fields: [examTypeId], references: [id])
  subjects     ExamSubject[]

  @@index([branchId])
  @@index([academicYearId])
  @@map("exams")
}

// Maps an Exam to a Subject with the max marks for that pairing, and (Section 6.8
// "Exam Timetable") the date that subject's paper is held.
model ExamSubject {
  id        String    @id @default(cuid())
  examId    String
  subjectId String
  maxMarks  Int
  passMarks Int?
  examDate  DateTime? @db.Date

  exam    Exam       @relation(fields: [examId], references: [id])
  subject Subject    @relation(fields: [subjectId], references: [id])
  marks   ExamMark[]

  @@unique([examId, subjectId])
  @@map("exam_subjects")
}

model ExamMark {
  id              String   @id @default(cuid())
  examSubjectId   String
  studentId       String
  marksObtained   Float
  enteredByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([examSubjectId, studentId])
  @@index([studentId])
  @@map("exam_marks")
}

model CompetitiveExam {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  examDate       DateTime? @db.Date
  createdAt      DateTime  @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id])
  marks        CompetitiveExamMark[]

  @@map("competitive_exams")
}

model CompetitiveExamMark {
  id                String   @id @default(cuid())
  competitiveExamId String
  studentId         String
  marksObtained     Float
  maxMarks          Float
  remarks           String?
  createdAt         DateTime @default(now())

  competitiveExam CompetitiveExam @relation(fields: [competitiveExamId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])

  @@unique([competitiveExamId, studentId])
  @@map("competitive_exam_marks")
}

// ---------------------------------------------------------------------------
// Phase 5: Communication (Section 6.9)
// ---------------------------------------------------------------------------

model Homework {
  id              String   @id @default(cuid())
  sectionId       String
  subjectId       String
  description     String
  dueDate         DateTime @db.Date
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  section     Section              @relation(fields: [sectionId], references: [id])
  subject     Subject              @relation(fields: [subjectId], references: [id])
  attachments HomeworkAttachment[]
  submissions HomeworkSubmission[]

  @@index([sectionId])
  @@map("homework")
}

model HomeworkAttachment {
  id         String   @id @default(cuid())
  homeworkId String
  url        String
  fileName   String
  createdAt  DateTime @default(now())

  homework Homework @relation(fields: [homeworkId], references: [id])

  @@map("homework_attachments")
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  LATE
}

model HomeworkSubmission {
  id            String                   @id @default(cuid())
  homeworkId    String
  studentId     String
  submittedAt   DateTime                 @default(now())
  attachmentUrl String?
  remarks       String?
  status        HomeworkSubmissionStatus @default(SUBMITTED)

  homework Homework @relation(fields: [homeworkId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
  @@map("homework_submissions")
}

enum NotificationTarget {
  ALL
  SECTION
  STUDENT
}

model Notification {
  id              String             @id @default(cuid())
  branchId        String
  title           String
  body            String
  targetType      NotificationTarget
  sectionId       String?
  studentId       String?
  createdByUserId String?
  createdAt       DateTime           @default(now())

  branch  Branch   @relation(fields: [branchId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  @@index([branchId])
  @@index([sectionId])
  @@index([studentId])
  @@map("notifications")
}

model Circular {
  id              String   @id @default(cuid())
  branchId        String
  title           String
  body            String
  sectionId       String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  branch  Branch   @relation(fields: [branchId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  @@index([branchId])
  @@index([sectionId])
  @@map("circulars")
}

model GalleryAlbum {
  id        String   @id @default(cuid())
  branchId  String
  title     String
  createdAt DateTime @default(now())

  branch Branch        @relation(fields: [branchId], references: [id])
  items  GalleryItem[]

  @@index([branchId])
  @@map("gallery_albums")
}

model GalleryItem {
  id        String   @id @default(cuid())
  albumId   String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  album GalleryAlbum @relation(fields: [albumId], references: [id])

  @@index([albumId])
  @@map("gallery_items")
}

model Video {
  id          String   @id @default(cuid())
  branchId    String
  title       String
  videoUrl    String
  description String?
  createdAt   DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("videos")
}

// One thread per student, shared by all guardians and any staff who message in.
model ChatThread {
  id        String   @id @default(cuid())
  studentId String   @unique
  createdAt DateTime @default(now())

  student  Student       @relation(fields: [studentId], references: [id])
  messages ChatMessage[]

  @@map("chat_threads")
}

model ChatMessage {
  id           String   @id @default(cuid())
  threadId     String
  senderUserId String
  body         String
  createdAt    DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])
  sender User       @relation(fields: [senderUserId], references: [id])

  @@index([threadId])
  @@map("chat_messages")
}
