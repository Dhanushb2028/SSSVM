// SSSVM School Management System — Prisma schema
// Phase 1: core organizational hierarchy, people, auth, and RBAC.
// Later phases add academics/finance/comms/etc. tables via new migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organizational hierarchy
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches         Branch[]
  courses          Course[]
  subjects         Subject[]
  examTypes        ExamType[]
  competitiveExams CompetitiveExam[]
  feeComponents    FeeComponent[]
  salaryComponents SalaryComponent[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  city           String?
  address        String?
  phone          String?
  isHostel       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization       Organization       @relation(fields: [organizationId], references: [id])
  academicYears      AcademicYear[]
  sections           Section[]
  students           Student[]
  staffMembers       StaffMember[]
  users              User[]
  appBanners         AppBanner[]
  scheduleEvents     ScheduleEvent[]
  exams              Exam[]
  notifications      Notification[]
  circulars          Circular[]
  galleryAlbums      GalleryAlbum[]
  videos             Video[]
  feeStructures      FeeStructure[]
  feeTransactions    FeeTransaction[]
  expenses           Expense[]
  bankTransactions   BankTransaction[]
  marketingOfficers  MarketingOfficer[]
  admissionEnquiries AdmissionEnquiry[]
  staffAttendance    StaffAttendance[]
  payslips           Payslip[]
  vehicles           Vehicle[]
  transportRoutes    TransportRoute[]
  hostels            Hostel[]

  @@index([organizationId])
  @@map("branches")
}

model AcademicYear {
  id        String   @id @default(cuid())
  branchId  String
  name      String // e.g. "2025-2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch          Branch           @relation(fields: [branchId], references: [id])
  sections        Section[]
  exams           Exam[]
  feeStructures   FeeStructure[]
  feeTransactions FeeTransaction[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("academic_years")
}

model Course {
  id             String    @id @default(cuid())
  organizationId String
  name           String // e.g. "Grade 5"
  orderIndex     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization       Organization       @relation(fields: [organizationId], references: [id])
  sections           Section[]
  feeStructures      FeeStructure[]
  admissionEnquiries AdmissionEnquiry[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("courses")
}

model Subject {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization     Organization        @relation(fields: [organizationId], references: [id])
  timetableEntries TimetableEntry[]
  syllabusTopics   SyllabusTopic[]
  lessonPlans      MonthlyLessonPlan[]
  examSubjects     ExamSubject[]
  homework         Homework[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("subjects")
}

// A Section is a year-specific mapping of a Course to a Branch, e.g. "5-A" for 2025-2026.
model Section {
  id             String    @id @default(cuid())
  academicYearId String
  branchId       String
  courseId       String
  name           String // e.g. "A"
  capacity       Int?
  classTeacherId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  academicYear     AcademicYear        @relation(fields: [academicYearId], references: [id])
  branch           Branch              @relation(fields: [branchId], references: [id])
  course           Course              @relation(fields: [courseId], references: [id])
  classTeacher     StaffMember?        @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])
  students         Student[]
  attendance       Attendance[]
  timetableEntries TimetableEntry[]
  syllabusTopics   SyllabusTopic[]
  lessonPlans      MonthlyLessonPlan[]
  homework         Homework[]
  notifications    Notification[]
  circulars        Circular[]

  @@unique([academicYearId, branchId, courseId, name])
  @@index([academicYearId])
  @@index([branchId])
  @@index([courseId])
  @@map("sections")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum StudentStatus {
  ACTIVE
  PROMOTED
  LEFT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Student {
  id              String        @id @default(cuid())
  admissionNumber String        @unique
  branchId        String
  sectionId       String?
  firstName       String
  lastName        String
  dob             DateTime
  gender          Gender
  photoUrl        String?
  bloodGroup      String?
  address         String?
  contactPhone    String?
  contactEmail    String?
  admissionDate   DateTime      @default(now())
  status          StudentStatus @default(ACTIVE)
  leftDate        DateTime?
  leftReason      String?
  tcEligible      Boolean       @default(false)
  tcIssued        Boolean       @default(false)
  tcNumber        String?
  tcIssuedDate    DateTime?
  fatherName      String?
  motherName      String?
  nationality     String?
  category        String?
  routeStopId     String?
  hostelRoomId    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  branch               Branch                @relation(fields: [branchId], references: [id])
  section              Section?              @relation(fields: [sectionId], references: [id])
  routeStop            RouteStop?            @relation(fields: [routeStopId], references: [id])
  hostelRoom           HostelRoom?           @relation(fields: [hostelRoomId], references: [id])
  guardians            StudentGuardian[]
  user                 User?
  attendance           Attendance[]
  examMarks            ExamMark[]
  competitiveExamMarks CompetitiveExamMark[]
  homeworkSubmissions  HomeworkSubmission[]
  notifications        Notification[]
  chatThread           ChatThread?
  feeTransactions      FeeTransaction[]
  convertedFromEnquiry AdmissionEnquiry?

  @@index([branchId])
  @@index([sectionId])
  @@index([status])
  @@index([deletedAt])
  @@index([routeStopId])
  @@index([hostelRoomId])
  @@map("students")
}

model Guardian {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  phone     String    @unique
  email     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  students StudentGuardian[]
  user     User?

  @@index([deletedAt])
  @@map("guardians")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model StudentGuardian {
  id           String               @id @default(cuid())
  studentId    String
  guardianId   String
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  createdAt    DateTime             @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
  @@map("student_guardians")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
}

enum StaffStatus {
  ACTIVE
  LEFT
}

model StaffMember {
  id             String         @id @default(cuid())
  branchId       String
  employeeCode   String         @unique
  firstName      String
  lastName       String
  designation    String
  department     String?
  employmentType EmploymentType @default(PERMANENT)
  qualification  String?
  photoUrl       String?
  phone          String
  email          String?
  address        String?
  joinDate       DateTime       @default(now())
  status         StaffStatus    @default(ACTIVE)
  leftDate       DateTime?
  leftReason     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  branch            Branch             @relation(fields: [branchId], references: [id])
  user              User?
  classesAsTeacher  Section[]          @relation("SectionClassTeacher")
  timetableEntries  TimetableEntry[]
  attendance        StaffAttendance[]
  salaryStructure   StaffSalaryComponent[]
  payslips          Payslip[]
  wardenOf          Hostel[]

  @@index([branchId])
  @@index([deletedAt])
  @@map("staff_members")
}

// ---------------------------------------------------------------------------
// Auth & RBAC
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  EXPORT
}

// Named permission sets assignable to ADMIN-role users to scope them to a subset
// of admin modules (e.g. "Front Office", "Finance Staff") without a new top-level role.
model PermissionProfile {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants PermissionGrant[]
  users  User[]

  @@map("permission_profiles")
}

// One row per (profile, module, action) grant, e.g. ("Finance Staff", "finance.fees", VIEW).
model PermissionGrant {
  id                  String           @id @default(cuid())
  permissionProfileId String
  module              String
  action              PermissionAction

  permissionProfile PermissionProfile @relation(fields: [permissionProfileId], references: [id])

  @@unique([permissionProfileId, module, action])
  @@index([permissionProfileId])
  @@map("permission_grants")
}

model User {
  id                  String    @id @default(cuid())
  role                Role
  username            String?   @unique // ADMIN / TEACHER login identifier
  mobile              String?   @unique // STUDENT / PARENT login identifier
  // Standalone admin accounts (no linked StaffMember/Student/Guardian) store their
  // own name/email here; linked accounts source these from the linked person record.
  name                String?
  email               String?   @unique
  passwordHash        String
  isActive            Boolean   @default(true)
  // Restricts an ADMIN-role user to one branch; null means org-wide (all branches) access.
  branchId            String?
  permissionProfileId String?
  studentId           String?   @unique
  guardianId          String?   @unique
  staffMemberId       String?   @unique
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  branch            Branch?            @relation(fields: [branchId], references: [id])
  permissionProfile PermissionProfile? @relation(fields: [permissionProfileId], references: [id])
  student           Student?           @relation(fields: [studentId], references: [id])
  guardian          Guardian?          @relation(fields: [guardianId], references: [id])
  staffMember       StaffMember?       @relation(fields: [staffMemberId], references: [id])

  sessions              Session[]
  auditLogs             AuditLog[]
  attendanceMarked      Attendance[]
  chatMessages          ChatMessage[]
  staffAttendanceMarked StaffAttendance[]
  payslipsGenerated     Payslip[]

  @@index([role])
  @@index([branchId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Required for all destructive/financial actions per Section 9: fee cancellations,
// bank transaction cancellations, bulk promotions, certificate-eligibility changes, bulk SMS.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "fee_receipt.cancel", "student.bulk_promote"
  entityType String // e.g. "FeeTransaction"
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2: Student home-screen banners (Section 6.4 "App home banners")
// ---------------------------------------------------------------------------

model AppBanner {
  id         String   @id @default(cuid())
  branchId   String
  title      String?
  imageUrl   String
  linkUrl    String?
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("app_banners")
}

// ---------------------------------------------------------------------------
// Phase 3: Attendance & Timetable (Section 6.6, 6.7 timetable)
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model Attendance {
  id             String           @id @default(cuid())
  studentId      String
  sectionId      String
  date           DateTime         @db.Date
  status         AttendanceStatus
  markedByUserId String?
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student  Student @relation(fields: [studentId], references: [id])
  section  Section @relation(fields: [sectionId], references: [id])
  markedBy User?   @relation(fields: [markedByUserId], references: [id])

  @@unique([studentId, date])
  @@index([sectionId, date])
  @@map("attendance")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model TimetableEntry {
  id        String   @id @default(cuid())
  sectionId String
  weekday   Weekday
  period    Int
  subjectId String
  teacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section Section      @relation(fields: [sectionId], references: [id])
  subject Subject      @relation(fields: [subjectId], references: [id])
  teacher StaffMember? @relation(fields: [teacherId], references: [id])

  @@unique([sectionId, weekday, period])
  @@index([sectionId])
  @@map("timetable_entries")
}

// ---------------------------------------------------------------------------
// Phase 4: Syllabus, Schedule, Lesson Plans (Section 6.7)
// ---------------------------------------------------------------------------

model SyllabusTopic {
  id            String    @id @default(cuid())
  sectionId     String
  subjectId     String
  topic         String
  description   String?
  plannedDate   DateTime  @db.Date
  completedDate DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([sectionId])
  @@index([subjectId])
  @@map("syllabus_topics")
}

model ScheduleEvent {
  id          String    @id @default(cuid())
  branchId    String
  title       String
  description String?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("schedule_events")
}

model MonthlyLessonPlan {
  id        String   @id @default(cuid())
  sectionId String
  subjectId String
  month     Int // 1-12
  year      Int
  planText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([sectionId, subjectId, month, year])
  @@index([sectionId])
  @@map("monthly_lesson_plans")
}

// ---------------------------------------------------------------------------
// Phase 4: Exams & Assessments (Section 6.8)
// ---------------------------------------------------------------------------

model ExamType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  exams        Exam[]

  @@unique([organizationId, name])
  @@map("exam_types")
}

model Exam {
  id             String    @id @default(cuid())
  branchId       String
  academicYearId String
  examTypeId     String
  name           String
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  includeInRank  Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  branch       Branch        @relation(fields: [branchId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  examType     ExamType      @relation(fields: [examTypeId], references: [id])
  subjects     ExamSubject[]

  @@index([branchId])
  @@index([academicYearId])
  @@map("exams")
}

// Maps an Exam to a Subject with the max marks for that pairing, and (Section 6.8
// "Exam Timetable") the date that subject's paper is held.
model ExamSubject {
  id        String    @id @default(cuid())
  examId    String
  subjectId String
  maxMarks  Int
  passMarks Int?
  examDate  DateTime? @db.Date

  exam    Exam       @relation(fields: [examId], references: [id])
  subject Subject    @relation(fields: [subjectId], references: [id])
  marks   ExamMark[]

  @@unique([examId, subjectId])
  @@map("exam_subjects")
}

model ExamMark {
  id              String   @id @default(cuid())
  examSubjectId   String
  studentId       String
  marksObtained   Float
  enteredByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([examSubjectId, studentId])
  @@index([studentId])
  @@map("exam_marks")
}

model CompetitiveExam {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  examDate       DateTime? @db.Date
  createdAt      DateTime  @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id])
  marks        CompetitiveExamMark[]

  @@map("competitive_exams")
}

model CompetitiveExamMark {
  id                String   @id @default(cuid())
  competitiveExamId String
  studentId         String
  marksObtained     Float
  maxMarks          Float
  remarks           String?
  createdAt         DateTime @default(now())

  competitiveExam CompetitiveExam @relation(fields: [competitiveExamId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])

  @@unique([competitiveExamId, studentId])
  @@map("competitive_exam_marks")
}

// ---------------------------------------------------------------------------
// Phase 5: Communication (Section 6.9)
// ---------------------------------------------------------------------------

model Homework {
  id              String   @id @default(cuid())
  sectionId       String
  subjectId       String
  description     String
  dueDate         DateTime @db.Date
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  section     Section              @relation(fields: [sectionId], references: [id])
  subject     Subject              @relation(fields: [subjectId], references: [id])
  attachments HomeworkAttachment[]
  submissions HomeworkSubmission[]

  @@index([sectionId])
  @@map("homework")
}

model HomeworkAttachment {
  id         String   @id @default(cuid())
  homeworkId String
  url        String
  fileName   String
  createdAt  DateTime @default(now())

  homework Homework @relation(fields: [homeworkId], references: [id])

  @@map("homework_attachments")
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  LATE
}

model HomeworkSubmission {
  id            String                   @id @default(cuid())
  homeworkId    String
  studentId     String
  submittedAt   DateTime                 @default(now())
  attachmentUrl String?
  remarks       String?
  status        HomeworkSubmissionStatus @default(SUBMITTED)

  homework Homework @relation(fields: [homeworkId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
  @@map("homework_submissions")
}

enum NotificationTarget {
  ALL
  SECTION
  STUDENT
}

model Notification {
  id              String             @id @default(cuid())
  branchId        String
  title           String
  body            String
  targetType      NotificationTarget
  sectionId       String?
  studentId       String?
  createdByUserId String?
  createdAt       DateTime           @default(now())

  branch  Branch   @relation(fields: [branchId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  @@index([branchId])
  @@index([sectionId])
  @@index([studentId])
  @@map("notifications")
}

model Circular {
  id              String   @id @default(cuid())
  branchId        String
  title           String
  body            String
  sectionId       String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  branch  Branch   @relation(fields: [branchId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  @@index([branchId])
  @@index([sectionId])
  @@map("circulars")
}

model GalleryAlbum {
  id        String   @id @default(cuid())
  branchId  String
  title     String
  createdAt DateTime @default(now())

  branch Branch        @relation(fields: [branchId], references: [id])
  items  GalleryItem[]

  @@index([branchId])
  @@map("gallery_albums")
}

model GalleryItem {
  id        String   @id @default(cuid())
  albumId   String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  album GalleryAlbum @relation(fields: [albumId], references: [id])

  @@index([albumId])
  @@map("gallery_items")
}

model Video {
  id          String   @id @default(cuid())
  branchId    String
  title       String
  videoUrl    String
  description String?
  createdAt   DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("videos")
}

// One thread per student, shared by all guardians and any staff who message in.
model ChatThread {
  id        String   @id @default(cuid())
  studentId String   @unique
  createdAt DateTime @default(now())

  student  Student       @relation(fields: [studentId], references: [id])
  messages ChatMessage[]

  @@map("chat_threads")
}

model ChatMessage {
  id           String   @id @default(cuid())
  threadId     String
  senderUserId String
  body         String
  createdAt    DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])
  sender User       @relation(fields: [senderUserId], references: [id])

  @@index([threadId])
  @@map("chat_messages")
}

// ---------------------------------------------------------------------------
// Phase 6: Finance & Fees (Section 6.10)
// ---------------------------------------------------------------------------

enum FeeComponentCategory {
  TUITION
  TRANSPORT
  HOSTEL
  BOOKS
  UNIFORM
  OTHER
}

model FeeComponent {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  category       FeeComponentCategory @default(TUITION)
  createdAt      DateTime             @default(now())
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id])
  structures   FeeStructure[]

  @@unique([organizationId, name])
  @@map("fee_components")
}

model FeeStructure {
  id             String   @id @default(cuid())
  branchId       String
  courseId       String
  academicYearId String
  feeComponentId String
  amount         Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch       Branch       @relation(fields: [branchId], references: [id])
  course       Course       @relation(fields: [courseId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  feeComponent FeeComponent @relation(fields: [feeComponentId], references: [id])

  @@unique([branchId, courseId, academicYearId, feeComponentId])
  @@index([branchId])
  @@index([courseId])
  @@index([academicYearId])
  @@map("fee_structures")
}

enum PaymentMode {
  CASH
  CHEQUE
  ONLINE
  CARD
}

model FeeTransaction {
  id                String      @id @default(cuid())
  receiptNumber     String      @unique
  studentId         String
  branchId          String
  academicYearId    String
  amount            Float
  mode              PaymentMode
  paidDate          DateTime    @db.Date
  remarks           String?
  collectedByUserId String?
  isCancelled       Boolean     @default(false)
  cancelledReason   String?
  cancelledAt       DateTime?
  cancelledByUserId String?
  createdAt         DateTime    @default(now())

  student      Student      @relation(fields: [studentId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([studentId])
  @@index([branchId])
  @@index([paidDate])
  @@map("fee_transactions")
}

model Expense {
  id                String    @id @default(cuid())
  branchId          String
  category          String?
  description       String
  amount            Float
  date              DateTime  @db.Date
  createdByUserId   String?
  isCancelled       Boolean   @default(false)
  cancelledReason   String?
  cancelledAt       DateTime?
  cancelledByUserId String?
  createdAt         DateTime  @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([date])
  @@map("expenses")
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
  RECEIVE
  PAY
  LOAN
}

model BankTransaction {
  id                String              @id @default(cuid())
  branchId          String
  type              BankTransactionType
  amount            Float
  date              DateTime            @db.Date
  description       String?
  createdByUserId   String?
  isCancelled       Boolean             @default(false)
  cancelledReason   String?
  cancelledAt       DateTime?
  cancelledByUserId String?
  createdAt         DateTime            @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([date])
  @@map("bank_transactions")
}

// ---------------------------------------------------------------------------
// Phase 7: Admissions CRM & Certificates (Section 6.3, 6.14)
// ---------------------------------------------------------------------------

model MarketingOfficer {
  id        String    @id @default(cuid())
  branchId  String
  firstName String
  lastName  String
  phone     String
  email     String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  branch    Branch             @relation(fields: [branchId], references: [id])
  enquiries AdmissionEnquiry[]

  @@index([branchId])
  @@map("marketing_officers")
}

// A single pipeline covers both the "enquiry" and "applications" stages the
// spec describes separately (6.3) — NEW..APPLIED are enquiry-side, ADMITTED
// is the one-click "convert to admission" outcome, LOST covers drop-off at
// any stage. One model instead of two avoids duplicating the same funnel.
enum EnquiryStatus {
  NEW
  CONTACTED
  VISITED
  APPLIED
  ADMITTED
  LOST
}

model AdmissionEnquiry {
  id                 String        @id @default(cuid())
  branchId           String
  courseId           String?
  studentName        String
  parentName         String
  phone              String
  email              String?
  source             String?
  visitCount         Int           @default(0)
  status             EnquiryStatus @default(NEW)
  assignedMeoId      String?
  feeCommitment      Float?
  notes              String?
  convertedStudentId String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  branch           Branch            @relation(fields: [branchId], references: [id])
  course           Course?           @relation(fields: [courseId], references: [id])
  assignedMeo      MarketingOfficer? @relation(fields: [assignedMeoId], references: [id])
  convertedStudent Student?          @relation(fields: [convertedStudentId], references: [id])

  @@index([branchId])
  @@index([status])
  @@map("admission_enquiries")
}

// ---------------------------------------------------------------------------
// Staff / HR (Phase 8)
// ---------------------------------------------------------------------------

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_DUTY
  LEAVE
}

model StaffAttendance {
  id             String                 @id @default(cuid())
  staffMemberId  String
  branchId       String
  date           DateTime               @db.Date
  status         StaffAttendanceStatus
  remarks        String?
  markedByUserId String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])
  markedBy    User?       @relation(fields: [markedByUserId], references: [id])

  @@unique([staffMemberId, date])
  @@index([branchId, date])
  @@map("staff_attendance")
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

model SalaryComponent {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  type           SalaryComponentType
  createdAt      DateTime            @default(now())
  deletedAt      DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id])
  structures   StaffSalaryComponent[]

  @@unique([organizationId, name])
  @@map("salary_components")
}

// Per-staff amount for a salary component; mirrors FeeStructure's per-course
// amount grid, edited the same way (one grid save per staff member).
model StaffSalaryComponent {
  id                String   @id @default(cuid())
  staffMemberId     String
  salaryComponentId String
  amount            Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  staffMember     StaffMember     @relation(fields: [staffMemberId], references: [id])
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@unique([staffMemberId, salaryComponentId])
  @@map("staff_salary_components")
}

// A generated payslip snapshots the salary structure at generation time (like
// a fee receipt) so later salary-structure edits never rewrite payroll history.
model Payslip {
  id              String   @id @default(cuid())
  staffMemberId   String
  branchId        String
  month           Int
  year            Int
  breakdown       Json
  grossEarnings   Float
  totalDeductions Float
  netPay          Float
  generatedById   String?
  createdAt       DateTime @default(now())

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])
  generatedBy User?       @relation(fields: [generatedById], references: [id])

  @@unique([staffMemberId, month, year])
  @@index([branchId, year, month])
  @@map("payslips")
}

// ---------------------------------------------------------------------------
// Transport (Phase 8)
// ---------------------------------------------------------------------------

model Vehicle {
  id            String    @id @default(cuid())
  branchId      String
  vehicleNumber String
  capacity      Int
  driverName    String
  driverPhone   String
  deletedAt     DateTime?

  branch Branch           @relation(fields: [branchId], references: [id])
  routes TransportRoute[]

  @@unique([branchId, vehicleNumber])
  @@index([branchId])
  @@map("vehicles")
}

model TransportRoute {
  id         String    @id @default(cuid())
  branchId   String
  name       String
  vehicleId  String?
  monthlyFee Float     @default(0)
  deletedAt  DateTime?

  branch  Branch      @relation(fields: [branchId], references: [id])
  vehicle Vehicle?    @relation(fields: [vehicleId], references: [id])
  stops   RouteStop[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("transport_routes")
}

model RouteStop {
  id         String @id @default(cuid())
  routeId    String
  name       String
  pickupTime String
  sequence   Int    @default(0)

  route    TransportRoute @relation(fields: [routeId], references: [id])
  students Student[]

  @@index([routeId])
  @@map("route_stops")
}

// ---------------------------------------------------------------------------
// Hostel (Phase 8)
// ---------------------------------------------------------------------------

model Hostel {
  id        String    @id @default(cuid())
  branchId  String
  name      String
  wardenId  String?
  deletedAt DateTime?

  branch Branch       @relation(fields: [branchId], references: [id])
  warden StaffMember? @relation(fields: [wardenId], references: [id])
  rooms  HostelRoom[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("hostels")
}

model HostelRoom {
  id         String @id @default(cuid())
  hostelId   String
  roomNumber String
  capacity   Int

  hostel   Hostel    @relation(fields: [hostelId], references: [id])
  students Student[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId])
  @@map("hostel_rooms")
}
